{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "SimpleCamPTZ - Windows x64",
      "description": "Visual Studio 2022 build for OBS Studio 32.2.1",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/simplecamptz-windows-x64",
      "cacheVariables": {
        "ENABLE_FRONTEND_API": "ON",
        "ENABLE_QT": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "SimpleCamPTZ - Apple Silicon",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/out/build/simplecamptz-macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "SIMPLECAM_USE_EXTERNAL_SDK": "ON",
        "SIMPLECAM_SKIP_AUTO_PACKAGE": "ON",
        "ENABLE_FRONTEND_API": "ON",
        "ENABLE_QT": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "SimpleCamPTZ - Ubuntu 24.04 x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/simplecamptz-linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_LIBDIR": "lib/x86_64-linux-gnu",
        "CMAKE_INSTALL_DATAROOTDIR": "share",
        "ENABLE_FRONTEND_API": "ON",
        "ENABLE_QT": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-x86_64",
      "displayName": "SimpleCamPTZ - Intel Mac",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/out/build/simplecamptz-macos-x86_64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "SIMPLECAM_USE_EXTERNAL_SDK": "ON",
        "SIMPLECAM_SKIP_AUTO_PACKAGE": "ON",
        "ENABLE_FRONTEND_API": "ON",
        "ENABLE_QT": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-arm64-relwithdebinfo",
      "configurePreset": "macos-arm64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-x64-relwithdebinfo",
      "configurePreset": "linux-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-x86_64-relwithdebinfo",
      "configurePreset": "macos-x86_64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
